# ============================================================================
# USTADH AHMED PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================
# Copy this file to `.env.local` (or configure in Netlify / Vercel / Cloudflare
# Pages environment variables) when connecting to a live Supabase backend.
#
# ⚠️ CRITICAL SECURITY RULE:
# NEVER place `SUPABASE_SERVICE_ROLE_KEY`, database passwords, or private JWT
# secrets inside HTML, client-side JavaScript, or `PUBLIC_*` / `VITE_*` vars.
# ============================================================================

# 1. Public Supabase Project Configuration (Safe for Browser with RLS Enabled)
PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLIC_ANON_KEY_ONLY"

# 2. Direct Booking & External Contact Links
PUBLIC_PREPLY_TUTOR_URL="https://preply.com/en/tutor/arabic-medical-scholar"
PUBLIC_CONTACT_EMAIL="contact@example.com"
PUBLIC_WHATSAPP_URL=""
PUBLIC_TELEGRAM_URL=""
PUBLIC_YOUTUBE_URL=""

# 3. Application Runtime & Security Flags
PUBLIC_DEFAULT_LANG="ar"
PUBLIC_STRICT_PRODUCTION_AUTH="true"
PUBLIC_STRIP_STUDENT_PII_ON_EXPORT="true"

# 4. Server-Only Secrets (For Edge Functions / CI Migrations ONLY — NEVER expose to browser)
# SUPABASE_SERVICE_ROLE_KEY="DO_NOT_EXPOSE_TO_CLIENT"
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
